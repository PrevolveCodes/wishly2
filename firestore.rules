rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsList(listId) {
      return signedIn()
        && exists(/databases/$(database)/documents/lists/$(listId))
        && get(/databases/$(database)/documents/lists/$(listId)).data.ownerUid == request.auth.uid;
    }

    function ownsListAfter(listId) {
      return signedIn()
        && existsAfter(/databases/$(database)/documents/lists/$(listId))
        && getAfter(/databases/$(database)/documents/lists/$(listId)).data.ownerUid == request.auth.uid;
    }

    function isPublicList(listId, shareId) {
      return exists(/databases/$(database)/documents/lists/$(listId))
        && get(/databases/$(database)/documents/lists/$(listId)).data.visibility == "public"
        && get(/databases/$(database)/documents/lists/$(listId)).data.shareId == shareId;
    }

    function isPublicListAfter(listId, shareId) {
      return existsAfter(/databases/$(database)/documents/lists/$(listId))
        && getAfter(/databases/$(database)/documents/lists/$(listId)).data.visibility == "public"
        && getAfter(/databases/$(database)/documents/lists/$(listId)).data.shareId == shareId;
    }

    function indexExists(shareId) {
      return exists(/databases/$(database)/documents/publicWishlistIndex/$(shareId));
    }

    function indexedListId(shareId) {
      return get(/databases/$(database)/documents/publicWishlistIndex/$(shareId)).data.listId;
    }

    function isPublicShare(shareId) {
      return indexExists(shareId) && isPublicList(indexedListId(shareId), shareId);
    }

    function isPublicShareAfter(shareId) {
      return existsAfter(/databases/$(database)/documents/publicWishlistIndex/$(shareId))
        && isPublicListAfter(
          getAfter(/databases/$(database)/documents/publicWishlistIndex/$(shareId)).data.listId,
          shareId
        );
    }

    match /users/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /lists/{listId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll(['title','ownerUid','shareId','visibility'])
        && request.resource.data.visibility in ['public','private']
        && !request.resource.data.keys().hasAny([
          'passwordHash','reservationStatuses','reservationCount',
          'passwordHolderUid','passwordHolderName','reservationProtectionActivated'
        ]);

      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'passwordHash','reservationStatuses','reservationCount',
          'passwordHolderUid','passwordHolderName','reservationProtectionActivated',
          'shareId','createdAt'
        ]);

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /items/{itemId} {
        allow read, write: if ownsList(listId);
      }
    }

    // Hidden lookup mapping: clients cannot read this collection.
    match /publicWishlistIndex/{shareId} {
      allow read: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['listId'])
        && request.resource.data.keys().hasAll(['listId'])
        && ownsListAfter(request.resource.data.listId)
        && isPublicListAfter(request.resource.data.listId, shareId);

      allow update: if signedIn()
        && ownsList(resource.data.listId)
        && request.resource.data.listId == resource.data.listId
        && request.resource.data.keys().hasOnly(['listId']);

      allow delete: if ownsList(resource.data.listId);
    }

    // Public mirror contains display fields only; no owner IDs or reservation details.
    match /publicWishlists/{shareId} {
      allow read: if isPublicShare(shareId);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'title','description','occasion','eventDate','passwordProtectionActive'
        ])
        && request.resource.data.keys().hasAll([
          'title','description','occasion','eventDate','passwordProtectionActive'
        ])
        && existsAfter(/databases/$(database)/documents/publicWishlistIndex/$(shareId))
        && ownsListAfter(getAfter(/databases/$(database)/documents/publicWishlistIndex/$(shareId)).data.listId)
        && isPublicShareAfter(shareId);

      allow update: if (
        signedIn()
        && isPublicShare(shareId)
        && ownsList(indexedListId(shareId))
        && request.resource.data.keys().hasOnly([
          'title','description','occasion','eventDate','passwordProtectionActive'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title','description','occasion','eventDate','passwordProtectionActive'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['passwordProtectionActive'])
          || (
            request.resource.data.passwordProtectionActive == true
            && exists(/databases/$(database)/documents/reservationSecrets/$(shareId))
          )
        )
      ) || (
        signedIn()
        && isPublicShare(shareId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passwordProtectionActive'])
        && request.resource.data.passwordProtectionActive == true
        && exists(/databases/$(database)/documents/reservationSecrets/$(shareId))
      );

      // Owners can remove a mirror when changing a list to private.
      allow delete: if indexExists(shareId) && ownsList(indexedListId(shareId));

      match /items/{itemId} {
        allow read: if isPublicShare(shareId);

        allow create, update: if signedIn()
          && isPublicShare(shareId)
          && ownsList(indexedListId(shareId))
          && request.resource.data.keys().hasOnly([
            'name','description','imageUrl','purchaseUrl','price'
          ]);

        allow delete: if indexExists(shareId) && ownsList(indexedListId(shareId));
      }
    }

    // Reservation secrets, access grants, and reservation records are server-only.
    match /reservationSecrets/{shareId} {
      allow read, write: if false;
    }

    match /reservationAccess/{grantId} {
      allow read, write: if false;
    }

    match /reservations/{shareId}/items/{itemId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}