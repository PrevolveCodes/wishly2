rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function hasWishlyAccount() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(userPath(request.auth.uid));
    }
    function listPath(id) { return /databases/$(database)/documents/lists/$(id); }
    function indexPath(id) { return /databases/$(database)/documents/publicWishlistIndex/$(id); }
    function publicPath(id) { return /databases/$(database)/documents/publicWishlists/$(id); }
    function publicItemPath(shareId, itemId) { return /databases/$(database)/documents/publicWishlists/$(shareId)/items/$(itemId); }
    function secretPath(id) { return /databases/$(database)/documents/reservationSecrets/$(id); }
    function challengePath(id) { return /databases/$(database)/documents/reservationChallenges/$(id); }
    function grantPath(shareId, uid) { return /databases/$(database)/documents/reservationAccess/$(shareId + '_' + uid); }

    function ownsListAfter(listId) {
      return signedIn() && existsAfter(listPath(listId))
        && getAfter(listPath(listId)).data.ownerUid == request.auth.uid;
    }
    function ownsList(listId) {
      return signedIn() && exists(listPath(listId))
        && get(listPath(listId)).data.ownerUid == request.auth.uid;
    }
    function isPublicList(listId, shareId) {
      return exists(listPath(listId))
        && get(listPath(listId)).data.visibility == 'public'
        && get(listPath(listId)).data.shareId == shareId;
    }
    function indexExists(shareId) { return exists(indexPath(shareId)); }
    function indexedListId(shareId) { return get(indexPath(shareId)).data.listId; }
    function isPublicShare(shareId) {
      return indexExists(shareId) && isPublicList(indexedListId(shareId), shareId);
    }
    function isOwner(shareId) {
      return signedIn() && isPublicShare(shareId)
        && get(listPath(indexedListId(shareId))).data.ownerUid == request.auth.uid;
    }
    function hasGrant(shareId) {
      return hasWishlyAccount() && !isOwner(shareId)
        && exists(grantPath(shareId, request.auth.uid))
        && get(grantPath(shareId, request.auth.uid)).data.uid == request.auth.uid
        && get(grantPath(shareId, request.auth.uid)).data.shareId == shareId;
    }

    match /users/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /lists/{listId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll(['title','ownerUid','shareId','visibility'])
        && request.resource.data.visibility in ['public','private']
        && !request.resource.data.keys().hasAny([
          'passwordHash','reservationStatuses','reservationCount',
          'passwordHolderUid','passwordHolderName','reservationProtectionActivated','reservationSalt'
        ]);
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'passwordHash','reservationStatuses','reservationCount',
          'passwordHolderUid','passwordHolderName','reservationProtectionActivated','reservationSalt',
          'shareId','createdAt'
        ])) || (signedIn()
        && resource.data.visibility == 'public'
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.shareId == resource.data.shareId
        && !resource.data.keys().hasAny(['reservationProtectionActivated','passwordHolderName','reservationSalt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reservationProtectionActivated','passwordHolderName','reservationSalt'])
        && request.resource.data.reservationProtectionActivated == true
        && existsAfter(secretPath(resource.data.shareId))
        && getAfter(secretPath(resource.data.shareId)).data.holderUid == request.auth.uid
        && getAfter(secretPath(resource.data.shareId)).data.holderName == request.resource.data.passwordHolderName
        && getAfter(secretPath(resource.data.shareId)).data.salt == request.resource.data.reservationSalt);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      match /items/{itemId} { allow read, write: if ownsList(listId); }
    }

    match /publicWishlistIndex/{shareId} {
      allow read: if ownsList(resource.data.listId) || isPublicList(resource.data.listId, shareId);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['listId'])
        && request.resource.data.keys().hasAll(['listId'])
        && existsAfter(listPath(request.resource.data.listId))
        && ownsListAfter(request.resource.data.listId)
        && getAfter(listPath(request.resource.data.listId)).data.visibility == 'public'
        && getAfter(listPath(request.resource.data.listId)).data.shareId == shareId;
      allow update: if signedIn() && ownsList(resource.data.listId)
        && request.resource.data.listId == resource.data.listId
        && request.resource.data.keys().hasOnly(['listId']);
      allow delete: if ownsList(resource.data.listId);
    }

    match /publicWishlists/{shareId} {
      allow read: if isPublicShare(shareId);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['title','description','occasion','eventDate','passwordProtectionActive','mirrorVersion','reservationSalt'])
        && request.resource.data.keys().hasAll(['title','description','occasion','eventDate','passwordProtectionActive','mirrorVersion'])
        && existsAfter(indexPath(shareId))
        && ownsListAfter(getAfter(indexPath(shareId)).data.listId)
        && getAfter(listPath(getAfter(indexPath(shareId)).data.listId)).data.visibility == 'public'
        && getAfter(listPath(getAfter(indexPath(shareId)).data.listId)).data.shareId == shareId;
      allow update: if (signedIn() && isPublicShare(shareId) && ownsList(indexedListId(shareId))
        && request.resource.data.keys().hasOnly(['title','description','occasion','eventDate','passwordProtectionActive','mirrorVersion','reservationSalt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','occasion','eventDate','passwordProtectionActive','mirrorVersion','reservationSalt']))
        || (signedIn() && isPublicShare(shareId) && !isOwner(shareId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passwordProtectionActive','reservationSalt'])
        && request.resource.data.passwordProtectionActive == true
        && existsAfter(secretPath(shareId))
        && getAfter(secretPath(shareId)).data.holderUid == request.auth.uid
        && request.resource.data.reservationSalt == getAfter(secretPath(shareId)).data.salt);
      allow delete: if indexExists(shareId) && ownsList(indexedListId(shareId));
      match /items/{itemId} {
        allow read: if isPublicShare(shareId);
        allow create, update: if signedIn() && isPublicShare(shareId)
          && ownsList(indexedListId(shareId))
          && request.resource.data.keys().hasOnly(['name','description','imageUrl','purchaseUrl','price']);
        allow delete: if indexExists(shareId) && ownsList(indexedListId(shareId));
      }
    }

    match /reservationSecrets/{shareId} {
      allow read: if false;
      allow create: if hasWishlyAccount() && isPublicShare(shareId) && !isOwner(shareId)
        && !exists(secretPath(shareId))
        && request.resource.data.keys().hasOnly(['holderUid','holderName','salt','passwordHash','createdAt'])
        && request.resource.data.holderUid == request.auth.uid
        && request.resource.data.holderName is string
        && request.resource.data.salt.matches('^[0-9a-f]{32}$')
        && request.resource.data.passwordHash.matches('^[0-9a-f]{128}$')
        && request.resource.data.createdAt == request.time
        && existsAfter(grantPath(shareId, request.auth.uid))
        && getAfter(grantPath(shareId, request.auth.uid)).data.uid == request.auth.uid
        && getAfter(grantPath(shareId, request.auth.uid)).data.shareId == shareId
        && getAfter(grantPath(shareId, request.auth.uid)).data.challengeId == 'password-holder';
      allow update, delete: if false;
    }

    match /reservationChallenges/{challengeId} {
      allow read: if false;
      allow create: if hasWishlyAccount()
        && request.resource.data.keys().hasOnly(['shareId','uid','nonce','proof','consumed','createdAt'])
        && request.resource.data.shareId is string
        && request.resource.data.shareId.size() >= 30
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nonce.matches('^[0-9a-f]{64}$')
        && request.resource.data.proof.matches('^[0-9a-f]{64}$')
        && request.resource.data.consumed == true
        && request.resource.data.createdAt == request.time
        && isPublicShare(request.resource.data.shareId)
        && !isOwner(request.resource.data.shareId)
        && exists(secretPath(request.resource.data.shareId))
        && request.resource.data.proof == hashing.sha256(
          get(secretPath(request.resource.data.shareId)).data.passwordHash + '|' +
          request.resource.data.nonce + '|' + request.auth.uid + '|' +
          request.resource.data.shareId + '|' + challengeId
        ).toHexString()
        && existsAfter(grantPath(request.resource.data.shareId, request.auth.uid))
        && getAfter(grantPath(request.resource.data.shareId, request.auth.uid)).data.challengeId == challengeId;
      allow update, delete: if false;
    }

    match /reservationAccess/{grantId} {
      allow read: if hasWishlyAccount() && resource.data.uid == request.auth.uid
        && !isOwner(resource.data.shareId) && isPublicShare(resource.data.shareId);
      allow create: if hasWishlyAccount()
        && request.resource.data.shareId is string
        && grantId == request.resource.data.shareId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','shareId','challengeId','grantedAt'])
        && request.resource.data.uid == request.auth.uid
        && isPublicShare(request.resource.data.shareId)
        && !isOwner(request.resource.data.shareId)
        && request.resource.data.grantedAt == request.time
        && ((request.resource.data.challengeId == 'password-holder'
          && existsAfter(secretPath(request.resource.data.shareId))
          && getAfter(secretPath(request.resource.data.shareId)).data.holderUid == request.auth.uid)
          || (request.resource.data.challengeId is string
          && existsAfter(challengePath(request.resource.data.challengeId))
          && getAfter(challengePath(request.resource.data.challengeId)).data.shareId == request.resource.data.shareId
          && getAfter(challengePath(request.resource.data.challengeId)).data.uid == request.auth.uid
          && getAfter(challengePath(request.resource.data.challengeId)).data.consumed == true));
      allow update, delete: if false;
    }

    match /reservations/{shareId}/items/{itemId} {
      allow read: if hasGrant(shareId);
      allow create: if hasGrant(shareId)
        && exists(publicItemPath(shareId, itemId))
        && request.resource.data.keys().hasOnly(['reservedBy','createdAt'])
        && request.resource.data.reservedBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if hasGrant(shareId) && resource.data.reservedBy == request.auth.uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}